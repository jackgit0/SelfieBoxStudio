# Salin menjadi backend/.env (dibaca otomatis oleh server). Jangan di-commit.
PORT=3000
JWT_SECRET=ganti-dengan-string-acak-panjang
STAFF_PIN=1234
DB_FILE=./snapia.db
BRAND=SelfieBox Studio
# URL publik situs (dipakai pada tautan reset sandi di email). Kosong = otomatis dari alamat server.
BASE_URL=http://localhost:3000
TZ_OFFSET_MIN=420
# Refund berhasil jika pembatalan dilakukan minimal sekian jam sebelum sesi
REFUND_MIN_HOURS=2

# Akun admin disimpan di DATABASE (tabel admin, password di-hash). Dua variabel ini HANYA dipakai sekali,
# saat tabel admin masih kosong. Kosong = adminstudio / admin123 (password bawaan -> wajib diganti saat login pertama).
# Setelah itu kelola lewat menu Akun Admin, atau: node reset-admin.js <username> <password-baru>
ADMIN_USER=
ADMIN_PASS=

# Tujuan email dari formulir Contact Us di homepage (kosong = MAIL_FROM / SMTP_USER)
CONTACT_EMAIL=
# Maks. percobaan login/daftar/reset per IP per menit
AUTH_RATE_LIMIT=10

# Folder gambar unggahan admin (studio/properti). Kosong = backend/media
MEDIA_DIR=

# Email (lupa sandi + invoice). Kosongkan SMTP_HOST = email disimpan ke folder backend/outbox (mode pengembangan).
# Contoh Gmail: aktifkan verifikasi 2 langkah lalu buat "App Password" (bukan sandi akun).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
