# Akun demo untuk presentasi. Salin menjadi backend/.env.demo (tidak di-commit), isi, lalu: npm run seed:demo
# Database yang diisi: DB_FILE dari berkas ini, atau dari .env, atau backend/snapia.db (sama dengan server).
# DB_FILE=./snapia.db

# Admin demo (minimal 8 karakter, huruf + angka). Tidak perlu ganti password saat login pertama.
DEMO_ADMIN_USER=adminstudio
DEMO_ADMIN_PASS=

# Customer demo (opsional; kosongkan semua untuk melewati). Telepon 8-15 digit, password minimal 6 karakter.
DEMO_CUSTOMER_NAME=Pelanggan Demo
DEMO_CUSTOMER_EMAIL=demo@selfiebox.test
DEMO_CUSTOMER_PHONE=081200000000
DEMO_CUSTOMER_PASS=

# Data demo (1 = isi, kosong = lewati): 4 customer contoh (@selfiebox.test, password sama dengan customer demo),
# booking di setiap status (tanggal relatif ke hari ini), item keuangan, dan sesi studio contoh.
# Booking milik customer demo dan customer contoh DIHAPUS lalu dibuat ulang setiap kali seed:demo dijalankan.
DEMO_DATA=1
